# ==============================================================================
# Multi-stage Dockerfile for EverGreen Provider Admin Web Console (Port 5174)
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/admin-web/package.json ./apps/admin-web/

RUN npm ci

COPY apps/admin-web/ ./apps/admin-web/
COPY tsconfig.json ./

RUN npm run build --workspace=admin-web

FROM nginx:alpine AS runner

RUN rm -rf /etc/nginx/conf.d/*

COPY deploy/docker/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/admin-web/dist /usr/share/nginx/html

EXPOSE 5174

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:5174/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
