# ==============================================================================
# Multi-stage Dockerfile for EverGreen Marketing Website (Port 3300)
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/marketing-web/package.json ./apps/marketing-web/

RUN npm ci

COPY apps/marketing-web/ ./apps/marketing-web/
COPY tsconfig.json ./

RUN npm run build --workspace=marketing-web

FROM nginx:alpine AS runner

RUN rm -rf /etc/nginx/conf.d/*

COPY deploy/docker/nginx-marketing.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/marketing-web/dist /usr/share/nginx/html

EXPOSE 3300

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3300/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
