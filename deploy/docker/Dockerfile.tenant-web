# ==============================================================================
# Multi-stage Dockerfile for EverGreen Tenant Web UI (Port 4000)
# ==============================================================================

# Stage 1: Build React Assets
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/types/package.json ./packages/types/
COPY packages/config/package.json ./packages/config/
COPY apps/web/package.json ./apps/web/

RUN npm ci

COPY packages/ ./packages/
COPY apps/web/ ./apps/web/
COPY tsconfig.json ./

# Build types and web
RUN npm run build --workspace=@evergreen/types && \
    npm run build --workspace=web

# Stage 2: Production Nginx Proxy & Static File Host
FROM nginx:alpine AS runner

# Remove default configuration
RUN rm -rf /etc/nginx/conf.d/*

# Copy custom Nginx configuration with reverse proxy for /api/backend to Tenant API
COPY deploy/docker/nginx-tenant.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
