# Optional public marketing host. Configure these variables only when hosting it.
{$EVERGREEN_MARKETING_DOMAIN} {
  encode zstd gzip
  redir /demo /demo/ 308
  @referenceThemes path /demo/ThemeOriginal/* /demo/ThemeFiber/* /demo/ThemePlatform/* /demo/ThemeTextile/* /demo/ThemeRealTimeProfit/*
  handle @referenceThemes {
    root * {$EVERGREEN_MARKETING_WEB_ROOT}
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    header X-Frame-Options DENY
    header X-Robots-Tag "noindex, nofollow"
    file_server
  }
  handle /demo/ThemeThreadStory/* {
    root * {$EVERGREEN_MARKETING_WEB_ROOT}
    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    header X-Frame-Options DENY
    header X-Robots-Tag "noindex, nofollow"
    file_server
  }
  handle /demo/ThemeGenesisAtelier/* {
    root * {$EVERGREEN_MARKETING_WEB_ROOT}
    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    header X-Frame-Options DENY
    header X-Robots-Tag "noindex, nofollow"
    file_server
  }
  handle /demo/* {
    root * {$EVERGREEN_MARKETING_WEB_ROOT}
    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    header X-Frame-Options DENY
    header X-Robots-Tag "noindex, nofollow"
    file_server
  }
  @contacts {
    path /marketing-api/site-settings
    method GET
  }
  handle @contacts {
    rewrite * /public/marketing-settings
    reverse_proxy 127.0.0.1:4300 {
      header_up -Authorization
      header_up -Cookie
      header_up -X-Provider-Key
    }
    header Cache-Control no-store
  }
  @assistant path /marketing-api/ai/marketing
  handle @assistant {
    uri strip_prefix /marketing-api
    reverse_proxy 127.0.0.1:4301
  }
  handle {
    root * {$EVERGREEN_MARKETING_WEB_ROOT}
    try_files {path} /index.html
    file_server
  }
  header X-Content-Type-Options nosniff
  header Referrer-Policy no-referrer
}
