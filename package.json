{
  "name": "evergreen",
  "version": "1.0.0",
  "private": true,
  "description": "Ever Green Yarn Management System",
  "overrides": {
    "proxy-addr": "2.0.8",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/dev-all.mjs",
    "start:all": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "ops": "node scripts/solo-ops.mjs",
    "dev": "node scripts/dev-evergreen.js",
    "setup:check": "node scripts/setup-check.js",
    "agent:check": "node agent-system/validate.mjs && node --test agent-system/runtime/planner.test.mjs",
    "db:studio": "node scripts/security/prisma-studio.cjs tenant",
    "db:studio:tenant": "node scripts/security/prisma-studio.cjs tenant",
    "db:studio:provider": "node scripts/security/prisma-studio.cjs provider",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docs:generate": "node scripts/generate-knowledge.mjs",
    "docs:check": "node scripts/generate-knowledge.mjs --check && node scripts/check-knowledge-links.mjs",
    "typecheck": "npm run typecheck -w apps/api && npx tsc --noEmit -p apps/web/tsconfig.json",
    "verify": "npm run generate -w @evergreen/database && npm run migrate:check -w @evergreen/database && npm run generate -w @evergreen/admin-database && npm run migrate:check -w @evergreen/admin-database && npm run typecheck && npm test && npm run test:e2e -w apps/api && npm run agent:check && npm run test:maintenance && npm run test:release && npm run audit:check && npm run docs:check && npm run build",
    "desktop": "npm run start -w apps/desktop",
    "dist:desktop": "npm run dist -w apps/desktop",
    "release:desktop": "node scripts/release/desktop.mjs",
    "deploy": "node scripts/release/deploy.mjs",
    "update": "node scripts/release/deploy.mjs update",
    "test:release": "node --test scripts/release/*.test.cjs scripts/release/*.test.mjs apps/desktop/*.test.cjs",
    "dev:marketing": "npm run dev -w marketing-web",
    "audit:roadmap": "node scripts/roadmap-audit.mjs",
    "audit:surface": "node scripts/project-audit.mjs",
    "audit:check": "node scripts/roadmap-audit.mjs --check && node scripts/project-audit.mjs --check",
    "test:maintenance": "node --test scripts/audit.test.mjs",
    "owner:start": "node scripts/security/owner-host.cjs start",
    "owner:activate": "node scripts/security/owner-host.cjs activate",
    "license:help": "node scripts/security/owner-license.cjs help",
    "test:licensing": "npm run build -w @evergreen/types && node --test scripts/security/licensing.test.cjs",
    "test:ai": "npm run build -w @evergreen/types && node --test scripts/security/ai-agents.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@prisma/client": "^5.22.0"
  },
  "dependencies": {
    "@nestjs/throttler": "^6.7.1",
    "prisma": "5.22.0"
  }
}
