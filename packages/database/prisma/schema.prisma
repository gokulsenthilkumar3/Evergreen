generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  username         String    @unique
  name             String?
  password         String
  role             String    @default("VIEWER")
  
  // Advanced Auth Fields
  currentChallenge String?
  totpSecret       String?
  isTotpEnabled    Boolean   @default(false)
  
  sessions         Session[]
  credentials      WebAuthnCredential[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
}

model WebAuthnCredential {
  id              String   @id // The credential ID generated by the device
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey       Bytes
  counter         BigInt
  deviceType      String
  backedUp        Boolean
  transports      String?  // Stored as JSON string
  createdAt       DateTime @default(now())
  lastUsed        DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String?  // Optional: Store JWT signature if needed, or just use ID
  ipAddress  String?
  location   String?
  device     String?
  userAgent  String?
  isValid    Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastActive DateTime @updatedAt
}

model CottonInventory {
  id           Int         @id @default(autoincrement())
  date         DateTime
  type         String
  quantity     Float
  bale         Float       @default(0)
  balance      Float
  reference    String
  batchId      String?
  productionId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  entryTimestamp DateTime  @default(now())
  createdBy    String?
  updatedBy    String?
  production   Production? @relation("CottonProduction", fields: [productionId], references: [id])
}

model YarnInventory {
  id           Int         @id @default(autoincrement())
  date         DateTime
  type         String
  quantity     Float
  balance      Float
  reference    String
  count        String?
  productionId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  entryTimestamp DateTime  @default(now())
  createdBy    String?
  updatedBy    String?
  production   Production? @relation("YarnProduction", fields: [productionId], references: [id])
}

model WasteInventory {
  id            Int         @id @default(autoincrement())
  date          DateTime
  type          String
  quantity      Float
  balance       Float
  reference     String
  wasteBlowRoom Float       @default(0)
  wasteCarding  Float       @default(0)
  wasteOE       Float       @default(0)
  wasteOthers   Float       @default(0)
  productionId  Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  entryTimestamp DateTime  @default(now())
  createdBy     String?
  updatedBy     String?
  production    Production? @relation("WasteProduction", fields: [productionId], references: [id])
}

model InwardBatch {
  id        Int      @id @default(autoincrement())
  batchId   String   @unique
  date      DateTime
  supplier  String
  bale      Int
  kg        Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entryTimestamp DateTime @default(now())
  createdBy    String?
  updatedBy    String?
  mergedFrom   String?
  isMerged     Boolean  @default(false)
  catalogueItemId Int?
  unitCost       Float?
}

model Production {
  id              Int                     @id @default(autoincrement())
  date            DateTime
  totalConsumed   Float
  totalProduced   Float
  totalWaste      Float
  totalIntermediate Float                 @default(0)
  processingCost  Float                  @default(0)
  wasteBlowRoom   Float                   @default(0)
  wasteCarding    Float                   @default(0)
  wasteOE         Float                   @default(0)
  wasteOthers     Float                   @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  entryTimestamp  DateTime                @default(now())
  createdBy       String?
  updatedBy       String?
  cottonInventory CottonInventory[]       @relation("CottonProduction")
  consumedBatches ProductionConsumption[]
  producedYarn    ProductionOutput[]
  yarnInventory   YarnInventory[]         @relation("YarnProduction")
  wasteInventory  WasteInventory[]        @relation("WasteProduction")
}

model ProductionConsumption {
  id           Int        @id @default(autoincrement())
  productionId Int
  batchNo      String
  bale         Float      @default(0)
  weight       Float
  createdAt    DateTime   @default(now())
  entryTimestamp DateTime @default(now())
  createdBy    String?
  updatedBy    String?
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
}

model ProductionOutput {
  id           Int        @id @default(autoincrement())
  productionId Int
  count        String
  weight       Float
  bags         Int
  remainingLog Float
  createdAt    DateTime   @default(now())
  entryTimestamp DateTime @default(now())
  createdBy    String?
  updatedBy    String?
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
}

model Outward {
  id           Int            @id @default(autoincrement())
  date         DateTime
  customerName String
  vehicleNo    String
  driverName   String?
  totalBags    Int            @default(0)
  totalWeight  Float          @default(0)
  status       String         @default("DISPATCHED")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  entryTimestamp DateTime     @default(now())
  createdBy    String?
  updatedBy    String?
  items        OutwardItem[]
  invoices     Invoice[]
}

model OutwardItem {
  id        Int      @id @default(autoincrement())
  outwardId Int
  count     String
  bags      Int
  weight    Float
  createdAt DateTime @default(now())
  entryTimestamp DateTime @default(now())
  createdBy    String?
  updatedBy    String?
  outward   Outward  @relation(fields: [outwardId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  module    String
  details   String
  username  String
  createdAt DateTime @default(now())
  entryTimestamp DateTime @default(now())
}

model SystemSettings {
  id                  Int      @id @default(autoincrement())
  companyName         String   @default("")
  address             String   @default("")
  gstin               String   @default("")
  phone               String   @default("")
  email               String   @default("")
  logo                String?
  autoBackup          Boolean  @default(true)
  emailNotifications  Boolean  @default(true)
  lowStockAlert       Boolean  @default(true)
  defaultInvoiceTheme String   @default("CLASSIC")
  lowStockThreshold   String   @default("500")
  maintenanceRate     String   @default("4")
  ebRate              String   @default("10")
  packageRate         String   @default("1.6")
  gstPercent          String   @default("18")
  language            String   @default("en")
  sellerState         String   @default("Tamil Nadu")
  supportedCounts     String?  @default("2,4,6,8,10")
  updatedAt           DateTime @updatedAt
  entryTimestamp      DateTime @default(now())
  createdBy           String?
  updatedBy           String?
}

model CostingEntry {
  id              Int      @id @default(autoincrement())
  date            DateTime
  category        String
  details         String?
  totalCost       Float

  unitsConsumed   Float?
  ratePerUnit     Float?
  noOfShifts      Int?
  workers         Int?
  yarnProduced    Float?
  rate            Float?
  description     String?
  type            String?
  title           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  entryTimestamp  DateTime @default(now())
  createdBy       String?
  updatedBy       String?
}

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNo       String        @unique
  date            DateTime
    customerName    String
    customerAddress String?
    customerGSTIN   String?
    sellerName      String?
    sellerAddress   String?
    sellerGSTIN     String?
  customerId      Int?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  sellerState     String        @default("Tamil Nadu")
  buyerState      String?
  dueDate         DateTime?
  discount        Float         @default(0)
  currency        String        @default("INR")
  documentHash    String?
  verificationKey String?
  salesOrderId    Int?
  salesOrder      SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  outwardId       Int?
  outward         Outward?      @relation(fields: [outwardId], references: [id])
  transportMode   String?
  vehicleNo       String?
  theme           String        @default("CLASSIC")
  
  subtotal        Float
  cgst            Float
  sgst            Float
  igst            Float         @default(0)
  total           Float

  // Additional Billing Fields
  issuerSignature String?
  customerSignature String?
  authorizedSignatory String?
  senderName      String?
  notes           String?
  terms           String?

  // Payment tracking
  status          String        @default("UNPAID")  // UNPAID, PARTIAL, PAID
  amountPaid      Float         @default(0)
  creditTotal     Float         @default(0)
  requestKey      String?       @unique
  requestHash     String?
  fulfilmentId    Int?
  fulfilment      WorkflowDocument? @relation("FulfilmentInvoices", fields: [fulfilmentId], references: [id])

  items           InvoiceItem[]
  payments        Payment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  entryTimestamp  DateTime      @default(now())
  createdBy       String?
  updatedBy       String?
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  yarnCount String       @default("")
  bags      Int          @default(0)
  weight    Float        @default(0)
  rate      Float
  itemId    Int?
  item      CatalogueItem? @relation(fields: [itemId], references: [id])
  description String?
  hsnSac      String?
  uom         String?
  quantity    Float?
  gstRate     Float       @default(0)
  discount    Float       @default(0)

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  date        DateTime
  amount      Float
  method      String   @default("CASH")   // CASH, BANK, UPI, CHEQUE
  reference   String?                      // cheque number, UPI ref, etc.
  notes       String?
  createdAt   DateTime @default(now())
  createdBy   String?

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ── EverGreen One unified commerce layer ───────────────────────────────────

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     CatalogueItem[]
}

model CatalogueCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     CatalogueItem[]
}

model CatalogueItem {
  id                Int       @id @default(autoincrement())
  sku               String    @unique
  name              String
  type              String    // RAW_MATERIAL, YARN, FINISHED_GOOD, JOB_WORK_MATERIAL, SERVICE
  description       String?
  uom               String    @default("KG")
  hsnSac            String?
  gstRate           Float     @default(0)
  salePrice         Float     @default(0)
  reorderLevel      Float     @default(0)
  costPrice         Float     @default(0)
  imageUrl          String?
  active            Boolean   @default(true)
  shopVisible       Boolean   @default(false)
  legacySource      String?
  legacyId          String?
  brandId           Int?
  brand             Brand?    @relation(fields: [brandId], references: [id])
  categoryId        Int?
  category          CatalogueCategory? @relation(fields: [categoryId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  stockMovements    StockMovement[]
  invoiceItems      InvoiceItem[]
  orderLines        SalesOrderLine[]
  jobDispatchLines  JobWorkDispatchLine[]
  jobReceiptLines   JobWorkReceiptLine[]
  inwardLines       InwardReceiptLine[]
  workflowLines     WorkflowLine[]
  lots              StockLot[]

  @@index([type])
  @@index([name])
}

model InwardReceipt {
  id              Int      @id @default(autoincrement())
  receiptNo       String   @unique
  date            DateTime @default(now())
  supplierName    String
  referenceNumber String?
  notes           String?
  total           Float    @default(0)
  createdBy       String?
  createdAt       DateTime @default(now())
  lines           InwardReceiptLine[]
}

model InwardReceiptLine {
  id        Int            @id @default(autoincrement())
  receiptId Int
  receipt   InwardReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId    Int
  item      CatalogueItem  @relation(fields: [itemId], references: [id])
  quantity  Float
  unitCost  Float
}

model CostingSheet {
  id          Int      @id @default(autoincrement())
  styleCode   String   @unique
  description String?
  status      String   @default("ACTIVE")
  total       Float    @default(0)
  components  String   // JSON: material, process and overhead rows
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockMovement {
  id            Int       @id @default(autoincrement())
  itemId        Int
  item          CatalogueItem @relation(fields: [itemId], references: [id])
  date          DateTime  @default(now())
  quantity      Float     // positive increases available stock; negative reduces it
  reservedQty   Float     @default(0)
  movementType  String    // INWARD, PRODUCTION_IN, JOB_DISPATCH, JOB_RECEIPT, SALES_RESERVE, SALES_RELEASE, INVOICE_OUT, ADJUSTMENT
  referenceType String?
  referenceId   String?
  notes         String?
  legacySource  String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  lotId         Int?
  lot           StockLot? @relation(fields: [lotId], references: [id])
  unitCost      Float?
  valuation     StockValuation?

  @@index([itemId, date])
  @@index([referenceType, referenceId])
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  gstin     String?
  state     String?    @default("Tamil Nadu")
  address   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  invoices  Invoice[]
  orders    SalesOrder[]
  ledger    CustomerLedgerEntry[]

  @@index([name])
}

model CustomerLedgerEntry {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  type        String   // INVOICE, PAYMENT, CREDIT_NOTE, ADJUSTMENT
  debit       Float    @default(0)
  credit      Float    @default(0)
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([customerId, date])
}

model JobWorker {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  gstin     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  challans  JobWorkChallan[]

  @@unique([name])
}

model JobWorkChallan {
  id          Int      @id @default(autoincrement())
  challanNo   String   @unique
  date        DateTime
  jobWorkerId Int
  jobWorker   JobWorker @relation(fields: [jobWorkerId], references: [id])
  processType String
  status      String   @default("DISPATCHED") // DISPATCHED, PART_RECEIVED, COMPLETED
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dispatchLines JobWorkDispatchLine[]
  receiptLines  JobWorkReceiptLine[]
}

model JobWorkDispatchLine {
  id         Int      @id @default(autoincrement())
  challanId  Int
  challan    JobWorkChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  itemId     Int
  item       CatalogueItem @relation(fields: [itemId], references: [id])
  quantity   Float
  createdAt  DateTime @default(now())
}

model JobWorkReceiptLine {
  id         Int      @id @default(autoincrement())
  challanId  Int
  challan    JobWorkChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  itemId     Int
  item       CatalogueItem @relation(fields: [itemId], references: [id])
  quantity   Float
  scrapQty   Float    @default(0)
  createdAt  DateTime @default(now())
}

model SalesOrder {
  id          Int       @id @default(autoincrement())
  orderNo     String    @unique
  date        DateTime  @default(now())
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id])
  status      String    @default("DRAFT") // DRAFT, CONFIRMED, PARTIALLY_INVOICED, INVOICED, CANCELLED
  subtotal    Float     @default(0)
  discount    Float     @default(0)
  total       Float     @default(0)
  notes       String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lines       SalesOrderLine[]
  invoices    Invoice[]
}

model SalesOrderLine {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      Int
  item        CatalogueItem @relation(fields: [itemId], references: [id])
  quantity    Float
  invoicedQty Float     @default(0)
  dispatchedQty Float   @default(0)
  rate        Float
  gstRate     Float     @default(0)
  discount    Float     @default(0)
}

// ── Phase 3.5 — Warehouse, Machine, QC and HR models ──────────────────────

model WarehouseLocation {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  zone        String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  stockMovements WarehouseMovement[]
}

model WarehouseMovement {
  id           Int               @id @default(autoincrement())
  locationId   Int
  location     WarehouseLocation @relation(fields: [locationId], references: [id])
  itemId       Int
  quantity     Float
  movementType String            // IN, OUT, TRANSFER
  referenceId  String?
  notes        String?
  createdBy    String?
  createdAt    DateTime          @default(now())

  @@index([locationId])
}

model Machine {
  id             Int                @id @default(autoincrement())
  name           String
  type           String             // RING_FRAME, OPEN_END, BLOW_ROOM, CARDING, etc.
  serialNo       String?            @unique
  manufacturer   String?
  purchasedAt    DateTime?
  active         Boolean            @default(true)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdBy      String?
  inspections    MachineInspection[]
}

model MachineInspection {
  id          Int      @id @default(autoincrement())
  machineId   Int
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  type        String   // PREVENTIVE, BREAKDOWN, PERIODIC
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  description String?
  cost        Float    @default(0)
  resolvedAt  DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([machineId])
}

model QualityInspection {
  id             Int      @id @default(autoincrement())
  date           DateTime @default(now())
  productionId   Int?
  batchId        String?
  yarnCount      String?
  sampleWeight   Float?
  tenacity       Float?
  elongation     Float?
  imperfections  Float?
  classimateFaults Float?
  unevenness     Float?
  status         String   @default("PENDING") // PENDING, PASS, FAIL, HOLD
  disposition    String?  // RELEASE, REPROCESS, SCRAP
  remarks        String?
  inspectedBy    String?
  lotId          Int?
  holdQuantity   Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
}

// Immutable operational documents. Lines retain their exact source line identity.
model WorkflowDocument {
  id            Int       @id @default(autoincrement())
  documentNo    String    @unique
  kind          String
  status        String    @default("POSTED")
  date          DateTime  @default(now())
  requestKey    String    @unique
  requestHash   String
  customerId    Int?
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  invoiceId     Int?
  orderId       Int?
  originId      Int?
  origin        WorkflowDocument? @relation("WorkflowOrigin", fields: [originId], references: [id])
  children      WorkflowDocument[] @relation("WorkflowOrigin")
  subtotal      Float     @default(0)
  tax           Float     @default(0)
  total         Float     @default(0)
  amountPaid    Float     @default(0)
  metadata      String    @default("{}")
  notes         String?
  createdBy     String
  createdAt     DateTime  @default(now())
  lines         WorkflowLine[]
  fulfilmentInvoices Invoice[] @relation("FulfilmentInvoices")
  @@index([kind, date])
  @@index([invoiceId])
  @@index([originId])
}

model WorkflowLine {
  id             Int      @id @default(autoincrement())
  documentId     Int
  document       WorkflowDocument @relation(fields: [documentId], references: [id])
  itemId         Int
  item           CatalogueItem @relation(fields: [itemId], references: [id])
  sourceLineId   Int?
  invoiceItemId  Int?
  lotId          Int?
  quantity       Float
  rejectedQty    Float    @default(0)
  rate           Float    @default(0)
  gstRate        Float    @default(0)
  discount       Float    @default(0)
  net            Float    @default(0)
  tax            Float    @default(0)
  direction      String   @default("IN")
  @@index([sourceLineId])
  @@index([invoiceItemId])
}

model Supplier {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  gstin       String?
  address     String?
  active      Boolean @default(true)
  documents   WorkflowDocument[]
}

model StockLot {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  itemId      Int
  item        CatalogueItem @relation(fields: [itemId], references: [id])
  grade       String?
  colour      String?
  owner       String  @default("COMPANY")
  origin      String?
  movements   StockMovement[]
  holds       StockHold[]
  createdAt   DateTime @default(now())
}

model StockHold {
  id          Int      @id @default(autoincrement())
  lotId       Int
  lot         StockLot @relation(fields: [lotId], references: [id])
  quantity    Float
  reason      String
  status      String   @default("HELD")
  inspectionId Int?
  createdBy   String
  releasedBy  String?
  createdAt   DateTime @default(now())
  releasedAt  DateTime?
}

model WipLot {
  id           Int      @id @default(autoincrement())
  productionId Int      @unique
  code         String   @unique
  quantity     Float
  remaining    Float
  date         DateTime
  status       String   @default("OPEN")
  unitCost     Float?
}

model JournalEntry {
  id           Int      @id @default(autoincrement())
  sourceKey    String   @unique
  date         DateTime
  description  String
  createdBy    String
  createdAt    DateTime @default(now())
  lines        JournalLine[]
}

model JournalLine {
  id           Int      @id @default(autoincrement())
  entryId      Int
  entry        JournalEntry @relation(fields: [entryId], references: [id])
  account      String
  party        String?
  debit        Float    @default(0)
  credit       Float    @default(0)
  @@index([account])
}

model StockValuation {
  id           Int      @id @default(autoincrement())
  movementId   Int      @unique
  movement     StockMovement @relation(fields: [movementId], references: [id])
  quantity     Float
  unitCost     Float?
  value        Float?
  status       String   @default("UNVALUED")
}

model AccountingPeriod {
  id           Int      @id @default(autoincrement())
  through      DateTime @unique
  closedBy     String
  reason       String
  createdAt    DateTime @default(now())
}

model Staff {
  id          Int      @id @default(autoincrement())
  employeeId  String   @unique
  name        String
  role        String   // OPERATOR, SUPERVISOR, MANAGER, TECHNICIAN
  department  String?
  phone       String?
  joinDate    DateTime?
  salaryType  String   @default("DAILY") // DAILY, MONTHLY
  dailyRate   Float    @default(0)
  monthlySalary Float  @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  payrollEntries PayrollEntry[]
  shiftAssignments ShiftAssignment[]
}

model Shift {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Morning, Afternoon, Night
  startTime   String   // "06:00"
  endTime     String   // "14:00"
  active      Boolean  @default(true)
  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftId   Int
  shift     Shift    @relation(fields: [shiftId], references: [id])
  date      DateTime
  present   Boolean  @default(true)
  overtime  Float    @default(0) // hours
  createdAt DateTime @default(now())
  createdBy String?

  @@index([staffId, date])
}

model PayrollEntry {
  id           Int      @id @default(autoincrement())
  staffId      Int
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month        String   // "2026-10"
  daysWorked   Float    @default(0)
  overtimeHrs  Float    @default(0)
  basicPay     Float    @default(0)
  overtime     Float    @default(0)
  deductions   Float    @default(0)
  netPay       Float    @default(0)
  paid         Boolean  @default(false)
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?

  @@unique([staffId, month])
  @@index([month])
}
