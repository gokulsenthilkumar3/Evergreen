// Generated by scripts/data/postgres-schema.mjs; edit the canonical schema first.
generator client {
  provider = "prisma-client-js"
  output = "../../generated/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SupportTicket {
  id          String   @id @default(cuid())
  requestKey  String   @unique
  subject     String
  description String
  category    String
  priority    String   @default("NORMAL")
  status      String   @default("OPEN")
  createdBy   String
  resolution  String?
  requesterId Int?
  assigneeId Int?
  queue String @default("TRIAGE")
  resolvedById Int?
  resolvedAt DateTime?
  confirmedById Int?
  confirmedAt DateTime?
  closedAt DateTime?
  tagsJson String @default("[]")
  customFieldsJson String @default("{}")
  watchersJson String @default("[]")
  dueAt DateTime?
  parentId String?
  mergedIntoId String?
  slaPolicyJson String?
  events SupportTicketEvent[]
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([createdBy, createdAt])
  @@index([status, updatedAt])
  @@index([assigneeId, status])
}

model SupportResource {
  id String @id @default(cuid())
  scopeKey String @unique
  kind String
  key String
  title String
  ownerId Int
  visibility String @default("TEAM")
  status String @default("ACTIVE")
  data String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions SupportResourceRevision[]
  @@index([kind, status, visibility])
}

model SupportResourceRevision {
  id String @id @default(cuid())
  resourceId String
  resource SupportResource @relation(fields:[resourceId],references:[id],onDelete:Restrict)
  version Int
  actorId Int
  actorUsername String
  snapshot String
  reason String
  createdAt DateTime @default(now())
  @@unique([resourceId, version])
}

model SupportTicketEvent {
  id String @id @default(cuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  version Int
  requestKey String? @unique
  actorId Int
  actorPublicId String?
  actorUsername String
  kind String
  visibility String @default("PUBLIC")
  payload String
  previousHash String
  hash String @unique
  createdAt DateTime @default(now())
  @@unique([ticketId, version])
  @@unique([ticketId, previousHash])
  @@index([ticketId, createdAt])
}

model User {
  id               Int       @id @default(autoincrement())
  publicId         String?   @unique @default(uuid())
  status           String    @default("ACTIVE")
  statusReason     String?
  statusChangedAt  DateTime?
  deletedAt        DateTime?
  department       String?
  site             String?
  locale           String    @default("en")
  timezone         String    @default("Asia/Kolkata")
  emailVerifiedAt  DateTime?
  failedLogins     Int       @default(0)
  lockedUntil      DateTime?
  actionTokens     AccountActionToken[]
  recoveryCodes    UserRecoveryCode[]
  externalIdentities UserExternalIdentity[]
  scopedAccess     Boolean   @default(false)
  accessRules      UserAccessRule[]
  email            String    @unique
  username         String    @unique
  name             String?
  password         String
  role             String    @default("VIEWER")
  
  // Advanced Auth Fields
  currentChallenge String?
  totpSecret       String?
  isTotpEnabled    Boolean   @default(false)
  
  sessions         Session[]
  credentials      WebAuthnCredential[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
}

model WebAuthnCredential {
  id              String   @id // The credential ID generated by the device
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey       Bytes
  counter         BigInt
  deviceType      String
  backedUp        Boolean
  transports      String?  // Stored as JSON string
  createdAt       DateTime @default(now())
  lastUsed        DateTime @updatedAt
}

model AccountActionToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        String
  email          String
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  deliveryStatus String    @default("PENDING")
  messageId      String?
  createdBy      String
  createdAt      DateTime  @default(now())
  @@index([userId, purpose, createdAt])
}

model UserRecoveryCode {
  id        String    @id @default(cuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, usedAt])
}

model UserExternalIdentity {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer    String
  subject   String
  createdAt DateTime @default(now())
  @@unique([issuer, subject])
  @@index([userId])
}

model UserAccessRule {
  id         String    @id @default(cuid())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method     String
  path       String
  effect     String
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdBy  String
  reason     String
  createdAt  DateTime  @default(now())
  @@index([userId, revokedAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String?  // Optional: Store JWT signature if needed, or just use ID
  ipAddress  String?
  location   String?
  device     String?
  userAgent  String?
  isValid    Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastActive DateTime @updatedAt
  expiresAt  DateTime?
  lastSeenAt DateTime?
}

model UserSessionPolicy {
