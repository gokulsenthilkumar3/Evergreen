  debit       Decimal @db.Decimal(24, 2)    @default(0)
  credit      Decimal @db.Decimal(24, 2)    @default(0)
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([customerId, date])
}

model JobWorker {
