}

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNo       String        @unique
  date            DateTime
    customerName    String
    customerAddress String?
    customerGSTIN   String?
    sellerName      String?
    sellerAddress   String?
    sellerGSTIN     String?
  customerId      Int?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  sellerState     String        @default("Tamil Nadu")
  buyerState      String?
  dueDate         DateTime?
  discount        Decimal @db.Decimal(24, 2)         @default(0)
  currency        String        @default("INR")
  documentHash    String?
  verificationKey String?
  salesOrderId    Int?
  salesOrder      SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  outwardId       Int?
  outward         Outward?      @relation(fields: [outwardId], references: [id])
  transportMode   String?
  vehicleNo       String?
  theme           String        @default("CLASSIC")
  
  subtotal        Decimal @db.Decimal(24, 2)
  cgst            Decimal @db.Decimal(24, 2)
  sgst            Decimal @db.Decimal(24, 2)
  igst            Decimal @db.Decimal(24, 2)         @default(0)
  total           Decimal @db.Decimal(24, 2)

  // Additional Billing Fields
  issuerSignature String?
  customerSignature String?
  authorizedSignatory String?
  senderName      String?
  notes           String?
  terms           String?

  // Payment tracking
  status          String        @default("UNPAID")  // UNPAID, PARTIAL, PAID
  amountPaid      Decimal @db.Decimal(24, 2)         @default(0)
  creditTotal     Decimal @db.Decimal(24, 2)         @default(0)
  requestKey      String?       @unique
  requestHash     String?
  fulfilmentId    Int?
  fulfilment      WorkflowDocument? @relation("FulfilmentInvoices", fields: [fulfilmentId], references: [id])

  items           InvoiceItem[]
  payments        Payment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  entryTimestamp  DateTime      @default(now())
  createdBy       String?
  updatedBy       String?
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  yarnCount String       @default("")
  bags      Int          @default(0)
  weight    Decimal @db.Decimal(24, 6)        @default(0)
  rate      Decimal @db.Decimal(24, 6)
  itemId    Int?
  item      CatalogueItem? @relation(fields: [itemId], references: [id])
  description String?
  hsnSac      String?
  uom         String?
  quantity    Decimal? @db.Decimal(24, 6)
  gstRate     Decimal @db.Decimal(24, 6)       @default(0)
  discount    Decimal @db.Decimal(24, 2)       @default(0)

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  date        DateTime
  amount      Decimal @db.Decimal(24, 2)
  method      String   @default("CASH")   // CASH, BANK, UPI, CHEQUE
  reference   String?                      // cheque number, UPI ref, etc.
  notes       String?
  createdAt   DateTime @default(now())
  createdBy   String?

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ── EverGreen One unified commerce layer ───────────────────────────────────

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     CatalogueItem[]
}

model CatalogueCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     CatalogueItem[]
}

model CatalogueItem {
  id                Int       @id @default(autoincrement())
  sku               String    @unique
  name              String
  type              String    // RAW_MATERIAL, YARN, FINISHED_GOOD, JOB_WORK_MATERIAL, SERVICE
  description       String?
  uom               String    @default("KG")
  hsnSac            String?
  gstRate           Decimal @db.Decimal(24, 6)     @default(0)
  salePrice         Decimal @db.Decimal(24, 6)     @default(0)
  reorderLevel      Decimal @db.Decimal(24, 6)     @default(0)
  costPrice         Decimal @db.Decimal(24, 6)     @default(0)
  imageUrl          String?
  active            Boolean   @default(true)
  shopVisible       Boolean   @default(false)
  legacySource      String?
  legacyId          String?
  brandId           Int?
  brand             Brand?    @relation(fields: [brandId], references: [id])
  categoryId        Int?
  category          CatalogueCategory? @relation(fields: [categoryId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  stockMovements    StockMovement[]
  invoiceItems      InvoiceItem[]
  orderLines        SalesOrderLine[]
  jobDispatchLines  JobWorkDispatchLine[]
  jobReceiptLines   JobWorkReceiptLine[]
  inwardLines       InwardReceiptLine[]
  workflowLines     WorkflowLine[]
  lots              StockLot[]

  @@index([type])
  @@index([name])
}

model InwardReceipt {
  id              Int      @id @default(autoincrement())
  receiptNo       String   @unique
  date            DateTime @default(now())
  supplierName    String
  referenceNumber String?
  notes           String?
  total           Decimal @db.Decimal(24, 2)    @default(0)
  createdBy       String?
  createdAt       DateTime @default(now())
  lines           InwardReceiptLine[]
}

model InwardReceiptLine {
  id        Int            @id @default(autoincrement())
  receiptId Int
  receipt   InwardReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId    Int
  item      CatalogueItem  @relation(fields: [itemId], references: [id])
  quantity  Decimal @db.Decimal(24, 6)
  unitCost  Decimal @db.Decimal(24, 6)
}

model CostingSheet {
  id          Int      @id @default(autoincrement())
  styleCode   String   @unique
  description String?
  status      String   @default("ACTIVE")
  total       Decimal @db.Decimal(24, 2)    @default(0)
  components  String   // JSON: material, process and overhead rows
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockMovement {
  id            Int       @id @default(autoincrement())
  itemId        Int
  item          CatalogueItem @relation(fields: [itemId], references: [id])
  date          DateTime  @default(now())
  quantity      Decimal @db.Decimal(24, 6)     // positive increases available stock; negative reduces it
  reservedQty   Decimal @db.Decimal(24, 6)     @default(0)
  movementType  String    // INWARD, PRODUCTION_IN, JOB_DISPATCH, JOB_RECEIPT, SALES_RESERVE, SALES_RELEASE, INVOICE_OUT, ADJUSTMENT
  referenceType String?
  referenceId   String?
  notes         String?
  legacySource  String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  lotId         Int?
  lot           StockLot? @relation(fields: [lotId], references: [id])
  unitCost      Decimal? @db.Decimal(24, 6)
  valuation     StockValuation?

  @@index([itemId, date])
  @@index([referenceType, referenceId])
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  gstin     String?
  state     String?    @default("Tamil Nadu")
  address   String?
