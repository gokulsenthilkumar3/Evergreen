  scrapQty   Decimal @db.Decimal(24, 6)    @default(0)
  createdAt  DateTime @default(now())
}

model SalesOrder {
  id          Int       @id @default(autoincrement())
  orderNo     String    @unique
  date        DateTime  @default(now())
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id])
  status      String    @default("DRAFT") // DRAFT, CONFIRMED, PARTIALLY_INVOICED, INVOICED, CANCELLED
  subtotal    Decimal @db.Decimal(24, 2)     @default(0)
  discount    Decimal @db.Decimal(24, 2)     @default(0)
  total       Decimal @db.Decimal(24, 2)     @default(0)
  notes       String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lines       SalesOrderLine[]
  invoices    Invoice[]
}

model SalesOrderLine {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      Int
  item        CatalogueItem @relation(fields: [itemId], references: [id])
  quantity    Decimal @db.Decimal(24, 6)
  invoicedQty Decimal @db.Decimal(24, 6)     @default(0)
  dispatchedQty Decimal @db.Decimal(24, 6)   @default(0)
  rate        Decimal @db.Decimal(24, 6)
  gstRate     Decimal @db.Decimal(24, 6)     @default(0)
  discount    Decimal @db.Decimal(24, 2)     @default(0)
}

// ── Phase 3.5 — Warehouse, Machine, QC and HR models ──────────────────────

model WarehouseLocation {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  zone        String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  stockMovements WarehouseMovement[]
}

model WarehouseMovement {
  id           Int               @id @default(autoincrement())
  locationId   Int
  location     WarehouseLocation @relation(fields: [locationId], references: [id])
  itemId       Int
  quantity     Decimal @db.Decimal(24, 6)
  movementType String            // IN, OUT, TRANSFER
  referenceId  String?
  notes        String?
  createdBy    String?
  createdAt    DateTime          @default(now())

  @@index([locationId])
}

model Machine {
  id             Int                @id @default(autoincrement())
  name           String
  type           String             // RING_FRAME, OPEN_END, BLOW_ROOM, CARDING, etc.
  serialNo       String?            @unique
  manufacturer   String?
  purchasedAt    DateTime?
  active         Boolean            @default(true)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdBy      String?
  inspections    MachineInspection[]
}

model MachineInspection {
  id          Int      @id @default(autoincrement())
  machineId   Int
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  type        String   // PREVENTIVE, BREAKDOWN, PERIODIC
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  description String?
  cost        Decimal @db.Decimal(24, 6)    @default(0)
  resolvedAt  DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([machineId])
}

model QualityInspection {
  id             Int      @id @default(autoincrement())
  date           DateTime @default(now())
  productionId   Int?
  batchId        String?
  yarnCount      String?
  sampleWeight   Decimal? @db.Decimal(24, 6)
  tenacity       Decimal? @db.Decimal(24, 6)
  elongation     Decimal? @db.Decimal(24, 6)
  imperfections  Decimal? @db.Decimal(24, 6)
  classimateFaults Decimal? @db.Decimal(24, 6)
  unevenness     Decimal? @db.Decimal(24, 6)
  status         String   @default("PENDING") // PENDING, PASS, FAIL, HOLD
  disposition    String?  // RELEASE, REPROCESS, SCRAP
  remarks        String?
  inspectedBy    String?
  lotId          Int?
  holdQuantity   Decimal? @db.Decimal(24, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
}

// Immutable operational documents. Lines retain their exact source line identity.
model WorkflowDocument {
  id            Int       @id @default(autoincrement())
  documentNo    String    @unique
  kind          String
  status        String    @default("POSTED")
  date          DateTime  @default(now())
  requestKey    String    @unique
  requestHash   String
  customerId    Int?
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  invoiceId     Int?
  orderId       Int?
  originId      Int?
  origin        WorkflowDocument? @relation("WorkflowOrigin", fields: [originId], references: [id])
  children      WorkflowDocument[] @relation("WorkflowOrigin")
  subtotal      Decimal @db.Decimal(24, 2)     @default(0)
  tax           Decimal @db.Decimal(24, 6)     @default(0)
  total         Decimal @db.Decimal(24, 2)     @default(0)
  amountPaid    Decimal @db.Decimal(24, 2)     @default(0)
  metadata      String    @default("{}")
  notes         String?
  createdBy     String
  createdAt     DateTime  @default(now())
  lines         WorkflowLine[]
  fulfilmentInvoices Invoice[] @relation("FulfilmentInvoices")
  @@index([kind, date])
  @@index([invoiceId])
  @@index([originId])
}

model WorkflowLine {
  id             Int      @id @default(autoincrement())
  documentId     Int
  document       WorkflowDocument @relation(fields: [documentId], references: [id])
  itemId         Int
  item           CatalogueItem @relation(fields: [itemId], references: [id])
  sourceLineId   Int?
  invoiceItemId  Int?
  lotId          Int?
  quantity       Decimal @db.Decimal(24, 6)
  rejectedQty    Decimal @db.Decimal(24, 6)    @default(0)
  rate           Decimal @db.Decimal(24, 6)    @default(0)
  gstRate        Decimal @db.Decimal(24, 6)    @default(0)
  discount       Decimal @db.Decimal(24, 2)    @default(0)
  net            Decimal @db.Decimal(24, 6)    @default(0)
  tax            Decimal @db.Decimal(24, 6)    @default(0)
  direction      String   @default("IN")
  @@index([sourceLineId])
  @@index([invoiceItemId])
}

model Supplier {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  gstin       String?
  address     String?
  active      Boolean @default(true)
  documents   WorkflowDocument[]
}

model StockLot {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  itemId      Int
  item        CatalogueItem @relation(fields: [itemId], references: [id])
  grade       String?
  colour      String?
  owner       String  @default("COMPANY")
  origin      String?
  movements   StockMovement[]
  holds       StockHold[]
  createdAt   DateTime @default(now())
}

model StockHold {
  id          Int      @id @default(autoincrement())
  lotId       Int
  lot         StockLot @relation(fields: [lotId], references: [id])
  quantity    Decimal @db.Decimal(24, 6)
  reason      String
  status      String   @default("HELD")
  inspectionId Int?
  createdBy   String
  releasedBy  String?
  createdAt   DateTime @default(now())
  releasedAt  DateTime?
}

model WipLot {
  id           Int      @id @default(autoincrement())
  productionId Int      @unique
  code         String   @unique
  quantity     Decimal @db.Decimal(24, 6)
  remaining    Decimal @db.Decimal(24, 6)
  date         DateTime
  status       String   @default("OPEN")
  unitCost     Decimal? @db.Decimal(24, 6)
}

model JournalEntry {
  id           Int      @id @default(autoincrement())
  sourceKey    String   @unique
  date         DateTime
  description  String
  createdBy    String
  createdAt    DateTime @default(now())
  lines        JournalLine[]
}

model JournalLine {
  id           Int      @id @default(autoincrement())
  entryId      Int
  entry        JournalEntry @relation(fields: [entryId], references: [id])
  account      String
  party        String?
  debit        Decimal @db.Decimal(24, 2)    @default(0)
  credit       Decimal @db.Decimal(24, 2)    @default(0)
  @@index([account])
}

model StockValuation {
  id           Int      @id @default(autoincrement())
  movementId   Int      @unique
  movement     StockMovement @relation(fields: [movementId], references: [id])
  quantity     Decimal @db.Decimal(24, 6)
  unitCost     Decimal? @db.Decimal(24, 6)
  value        Decimal? @db.Decimal(24, 6)
  status       String   @default("UNVALUED")
}

model AccountingPeriod {
  id           Int      @id @default(autoincrement())
  through      DateTime @unique
  closedBy     String
  reason       String
  createdAt    DateTime @default(now())
}

model Staff {
  id          Int      @id @default(autoincrement())
  employeeId  String   @unique
  name        String
  role        String   // OPERATOR, SUPERVISOR, MANAGER, TECHNICIAN
  department  String?
  phone       String?
  joinDate    DateTime?
  salaryType  String   @default("DAILY") // DAILY, MONTHLY
  dailyRate   Decimal @db.Decimal(24, 6)    @default(0)
  monthlySalary Decimal @db.Decimal(24, 2)  @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  payrollEntries PayrollEntry[]
  shiftAssignments ShiftAssignment[]
}

model Shift {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Morning, Afternoon, Night
  startTime   String   // "06:00"
  endTime     String   // "14:00"
  active      Boolean  @default(true)
  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftId   Int
  shift     Shift    @relation(fields: [shiftId], references: [id])
  date      DateTime
  present   Boolean  @default(true)
  overtime  Decimal @db.Decimal(24, 6)    @default(0) // hours
  createdAt DateTime @default(now())
  createdBy String?

  @@index([staffId, date])
}

model PayrollEntry {
  id           Int      @id @default(autoincrement())
  staffId      Int
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month        String   // "2026-10"
  daysWorked   Decimal @db.Decimal(24, 6)    @default(0)
  overtimeHrs  Decimal @db.Decimal(24, 6)    @default(0)
  basicPay     Decimal @db.Decimal(24, 2)    @default(0)
  overtime     Decimal @db.Decimal(24, 6)    @default(0)
  deductions   Decimal @db.Decimal(24, 6)    @default(0)
  netPay       Decimal @db.Decimal(24, 2)    @default(0)
  paid         Boolean  @default(false)
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?

  @@unique([staffId, month])
  @@index([month])
}
