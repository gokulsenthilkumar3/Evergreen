{
    "name": "@evergreen/database",
    "version": "1.0.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "generate": "prisma generate --schema prisma/schema.prisma",
        "db:push": "prisma db push --schema prisma/schema.prisma",
        "db:studio": "prisma studio --schema prisma/schema.prisma",
        "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
        "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
        "migrate:status": "prisma migrate status --schema prisma/schema.prisma",
        "migrate:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url file:./readiness-shadow.db --exit-code"
    },
    "dependencies": {
        "@prisma/client": "5.22.0"
    },
    "devDependencies": {
        "prisma": "5.22.0"
    }
}
