generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/admin-client"
}

datasource db {
  provider = "sqlite"
  url      = env("ADMIN_DATABASE_URL")
}

// Execution records are separate from operator-editable control records.
model ReleaseJob {
  id           String   @id @default(uuid())
  requestKey   String   @unique
  fingerprint  String
  kind         String
  companyId    String?
  target       String
  version      String
  commit       String
  actor        String
  status       String   @default("REQUESTED")
  activeTarget String?  @unique
  runId        String?
  runUrl       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind, createdAt])
}

model Company {
  id             String   @id @default(uuid())
  name           String
  deploymentUrl  String?
  cloudProvider  String   @default("LOCAL_VM")
  appVersion     String   @default("1.0.0")
  apiKey         String   @unique
  plan           String   @default("SEED")
  businessMode   String   @default("INTEGRATED")
  workspaceMode  String   @default("GUIDED")
  activeStaff    Int      @default(0)
  docsPosted     Int      @default(0)
  // Regional & Planetary Tiers
  tier                String   @default("TIER_2_CITY") // TIER_1_CITY, TIER_2_CITY, RURAL, INTERNATIONAL
  state               String   @default("Tamil Nadu")
  country             String   @default("IN")

  // Granular Licensing, Dates & Quotas
  pricingModel        String   @default("TIERED") // TRIAL, TIERED, PAYG
  licenseKey          String?
  validFrom           DateTime @default(now())
  expiresAt           DateTime?
  gracePeriodDays     Int      @default(30) // 30-Day Unrestricted Grace Period Quota
  graceExpiresAt      DateTime?
  maxUsers            Int      @default(1) // Single-email license = 1; Multi-email = N
  maxMachines         Int      @default(5) // Machine license quota
  maxDocsPerMonth     Int      @default(500) // Transaction volume cap
  allowedModules      String   @default("CORE,INVENTORY,COMMERCE") // e.g. "CORE,INVENTORY,COMMERCE,MACHINES,QUALITY,HR,JOBWORK"
  isMaintenance       Boolean  @default(false)
  lastMigrationStatus String   @default("UP_TO_DATE")
  status              String   @default("ACTIVE")
  lastSyncAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  metrics             CompanyMetrics[]
  actions             RemoteAction[]
  domains             CompanyDomain[]
  accountPlan         CustomerAccountPlan?
}

model CompanyDomain {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hostname    String   @unique
  kind        String   @default("SUBDOMAIN")
  verificationToken String @unique
  isPrimary   Boolean  @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model CustomerPlanTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  kind        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  milestones  CustomerPlanTemplateMilestone[]
  plans       CustomerAccountPlan[]
}

model CustomerPlanTemplateMilestone {
  id           String   @id @default(uuid())
  templateId   String
  template     CustomerPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title        String
  phase        String
  daysFromStart Int     @default(0)
  priority     String   @default("NORMAL")
  createdAt    DateTime @default(now())
  @@index([templateId])
}

model CustomerAccountPlan {
  id             String   @id @default(uuid())
  companyId      String   @unique
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId     String?
  template       CustomerPlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  lifecycleStage String   @default("ONBOARDING")
  summary        String?
  nextReviewAt   DateTime?
  healthScore    Int      @default(0)
  healthBand     String   @default("AT_RISK")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  milestones     CustomerPlanMilestone[]
  risks          CustomerPlanRisk[]
  alerts         CustomerAlert[]
  activities     CustomerPlanActivity[]
  @@index([lifecycleStage, healthBand])
}

model CustomerPlanMilestone {
  id          String   @id @default(uuid())
  planId      String
  plan        CustomerAccountPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  phase       String
  owner       String?
  priority    String   @default("NORMAL")
  status      String   @default("OPEN")
  dueAt       DateTime?
  completedAt DateTime?
  blocker     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([planId, status, dueAt])
}

model CustomerPlanRisk {
  id          String   @id @default(uuid())
  planId      String
  plan        CustomerAccountPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  details     String?
  severity    String   @default("MEDIUM")
  status      String   @default("OPEN")
  mitigation  String?
  dueAt       DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([planId, status, severity])
}

model CustomerAlert {
  id             String   @id @default(uuid())
  planId         String
  plan           CustomerAccountPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  fingerprint    String   @unique
  type           String
  severity       String   @default("MEDIUM")
  status         String   @default("OPEN")
  title          String
  details        String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([planId, status, severity])
}

model CustomerPlanActivity {
  id        String   @id @default(uuid())
  planId    String
  plan      CustomerAccountPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  action    String
  actor     String
  details   String?
  createdAt DateTime @default(now())
  @@index([planId, createdAt])
}

model RemoteAction {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actionType  String   // TRIGGER_MIGRATION, TOGGLE_MAINTENANCE, FORCE_SYNC, REFRESH_LICENSE
  status      String   @default("PENDING") // PENDING, EXECUTED, FAILED
  details     String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([companyId])
}

model CompanyMetrics {
  id                Int      @id @default(autoincrement())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date              DateTime
  totalInwards      Int      @default(0)
  totalOutwards     Int      @default(0)
  totalInvoices     Int      @default(0)
  activeUsers       Int      @default(0)
  additionalMetrics String?
  createdAt         DateTime @default(now())

  @@unique([companyId, date])
}

model ProviderAdmin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("SUPER_ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ControlRecord {
  id         String   @id @default(uuid())
  kind       String
  title      String
  companyId  String?
  status     String   @default("DRAFT")
  priority   String   @default("NORMAL")
  owner      String   @default("Unassigned")
  dueAt      DateTime?
  payload    String   @default("{}")
  version    Int      @default(1)
  requestKey String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([kind, status])
}

model ControlAudit {
  id        String   @id @default(uuid())
  recordId  String?
  actor     String
  action    String
  details   String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Immutable observations and append-only hash chain. SQL triggers reject mutation.
model AuditLedger {
  seq Int @id @default(autoincrement())
  id String @unique
  sourceKey String @unique
  entityType String
  entityId String
  title String
  actor String
  action String
  state String
  evidenceRef String?
  payloadDigest String
  hashPrev String
  hashCurr String
  at String
  @@index([entityType, entityId, seq])
}
model EvidenceObservation {
  seq Int @id @default(autoincrement())
  id String @unique
  entityType String
  entityId String
  entityDigest String
  ok Boolean
  source String
  scope String
  observedAt String
  ttlSeconds Int
  latencyMs Int?
  statusCode Int?
  @@index([entityType, entityId, seq])
}
model OperationRequest {
  id String @id
  requestKey String @unique
  kind String
  entityId String
  actor String
  payload String
  state String @default("requested")
  at String
  @@index([kind, at])
}
