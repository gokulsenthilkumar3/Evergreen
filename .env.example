# EverGreen Environment Variables
# Copy this to .env and fill in all required values.
# NEVER commit .env to version control.
# Groq server-only configuration. Never use VITE_ variables for AI keys.
# Private: owner/staff. Public: customer/marketing, separate restricted Groq project/key recommended.
GROQ_ADMIN_API_KEY=
GROQ_CUSTOMER_API_KEY=
GROQ_MARKETING_API_KEY=
# Legacy fallback keys:
GROQ_API_KEY=
GROQ_PUBLIC_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Windows owner: scripts/security/configure-groq.ps1 saves protected config outside Git.

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL="file:../packages/database/prisma/dev.db"
# PostgreSQL (production) — uncomment and configure:
# DATABASE_URL="postgresql://evergreen:CHANGE_ME@localhost:5432/evergreen_db"

# ── Authentication ─────────────────────────────────────────────────────────
# Must be ≥32 characters, cryptographically random.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
# Field-encryption key, at least 32 random characters, unique per installation.
# The container recipe requires it; encryption refuses to run without it (there is no built-in key).
# ENCRYPTION_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# ── Server Ports ───────────────────────────────────────────────────────────
EVERGREEN_API_PORT=4301
EVERGREEN_PUBLIC_PORT=4000
# HOST for API (default 127.0.0.1 in dev, 0.0.0.0 in prod)
# EVERGREEN_API_HOST=0.0.0.0

# ── CORS ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4000

# ── Node Environment ───────────────────────────────────────────────────────
NODE_ENV=development
# Business time zone. "Today", stock event dates and the 23:59 daily summary use the server clock,
# and containers default to UTC. Indian installations should set:
# TZ=Asia/Kolkata

# ── Bootstrap Admin (one-time setup, remove after first run) ───────────────
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_MUST_BE_12_CHARS  # min 12 characters

# ── Email / SMTP ───────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=CHANGE_ME
# Real app credentials belong in local secrets; these are sender defaults only.
SMTP_PRIMARY_HOST=smtp.gmail.com
SMTP_PRIMARY_PORT=587
SMTP_PRIMARY_SECURE=false
SMTP_PRIMARY_USER=gokulkangeyan@gmail.com
SMTP_PRIMARY_FROM=gokulkangeyan@gmail.com
# SMTP_PRIMARY_PASSWORD=
# Verify the regional host in your Zoho mailbox settings before enabling it.
SMTP_SECONDARY_HOST=smtp.zoho.in
SMTP_SECONDARY_PORT=465
SMTP_SECONDARY_SECURE=true
SMTP_SECONDARY_USER=gokulsenthilkumar3@zohomail.in
SMTP_SECONDARY_FROM=gokulsenthilkumar3@zohomail.in
# SMTP_SECONDARY_PASSWORD=
# OIDC is unavailable until a client is registered with the selected provider.
OIDC_ISSUER=https://accounts.google.com
OIDC_LABEL=Google
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:4000/api/backend/auth/oidc/callback
PUBLIC_APP_URL=http://localhost:4000
INVITE_TTL_HOURS=24

# ── Daily Summary Email ────────────────────────────────────────────────────
# Recipient for the nightly production + cost summary, sent at 23:59 by the server clock (see TZ above)
# DAILY_SUMMARY_EMAIL=manager@example.com

# ── Redis (for caching / future queue) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Vite (Web App) ─────────────────────────────────────────────────────────
# Override the API base URL in the web app (optional, uses /api/backend proxy by default)
# VITE_API_URL=http://localhost:4301
# Provider support number shown on licence notices: international digits without "+", e.g. 919800000000.
# Unset hides the call and WhatsApp buttons. Docker builds read EVERGREEN_SUPPORT_PHONE instead.
# VITE_SUPPORT_PHONE=

# Optional HTTPS geolocation provider. Disabled when unset; use {ip} in the URL.
# Provider response should include status, city and country.
# GEOLOCATION_URL=https://your-provider.example/json/{ip}

# Optional provider metrics/license sync (disabled when unset).
# Configure both values only for a controlled integration environment.
# Tenant-scoped provider authentication is still pending; never use ADMIN_API_KEY here.
# ADMIN_API_URL=https://your-provider.example
# COMPANY_ID=provider-issued-company-id
# HTTPS is required in production; loopback HTTP is allowed for local development.
# Sync runs hourly with a 10-second HTTP deadline. Invoice totals are lifetime counts.

# Optional read-only local Tally company check; Tally must run on the API machine.
# TALLY_PORT=9000

# Owner-controlled installation licences: see docs/OWNER_LICENSING.md.
# No private signing key or provider access key belongs in source or VITE_* settings.
# EVERGREEN_LICENSE_FILE=C:/private/activation/tenant.json
# EVERGREEN_INSTALLATION_KEY_FILE=C:/private/activation/installation-key.json
# Optional online renewal; requires a configured owner HTTPS issuer and an approved device grant.
# EVERGREEN_LICENSE_RENEWAL_URL=https://YOUR-OWNER-DOMAIN/licensing/lease
# Owner issuer only, running under the owner Windows account:
# EVERGREEN_OWNER_KEY_DIRECTORY=C:/Users/OWNER/AppData/Local/EverGreen/owner-keys

# Optional Helpdesk local antivirus and signed producers: docs/HELPDESK_SETUP.md.
# Scanner failures quarantine attachments. clamd must remain loopback-only.
# HELPDESK_CLAMAV_HOST=127.0.0.1
# HELPDESK_CLAMAV_PORT=3310
# Generate distinct random secrets locally, each at least 32 characters.
# HELPDESK_INGRESS_MONITOR_SECRET=
# HELPDESK_INGRESS_DEPLOYMENT_SECRET=
# HELPDESK_INGRESS_WEBHOOK_SECRET=
# HELPDESK_INGRESS_HEARTBEAT_SECRET=
# HELPDESK_INGRESS_CHATOPS_SECRET=
# HELPDESK_INGRESS_EMAIL_SECRET=
